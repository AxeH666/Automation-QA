      "id": "b4b5331b-0cd8-4088-94b4-145fcc3bd824",
      "name": "Ping app",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entry = $input.first()?.json || {};\nconst started = $('Start timer').first().json.startedMs;\nconst elapsedMs = Math.max(0, Date.now() - started);\nconst code = typeof entry.statusCode === 'number' ? entry.statusCode : null;\nconst healthy = code === 200 && !entry.error;\nconst detail = entry.error ? String(entry.error.message || JSON.stringify(entry.error)) : (code === null ? 'No HTTP status recorded' : 'HTTP '+code);\nconst text = `🚨 UPTIME ALERT: vue-vuex-realworld.netlify.app\\n${detail}\\nResponse time (incl. retries): ${elapsedMs}ms\\nChecked: ${new Date().toISOString()}\\nTarget: https://vue-vuex-realworld.netlify.app/`;\nconsole.log(JSON.stringify({check:'vue-vuex-realworld.netlify.app',code,elapsedMs,healthy,detail}));\nreturn [{json:{healthy,statusCode:code,responseTimeMs:elapsedMs,detail,message:text}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ],
      "id": "2b8a2ece-d7e3-4d68-bc09-304911173d88",
      "name": "Evaluate status and elapsed"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d66dbac0-aaa2-4803-8c99-ea89262b6a9c",
              "leftValue": "={{ !$json.healthy }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        200
      ],
      "id": "e4d65ae6-7a4e-42f1-a7c7-4e837ac33f90",
      "name": "Not HTTP 200?"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1160,
