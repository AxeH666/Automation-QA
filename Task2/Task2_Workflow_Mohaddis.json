      ],
      "id": "557bde2d-a207-4614-9c98-15a065455c25",
      "name": "Every 1 hour"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/repositories?q=topic%3Aautomation+archived%3Afalse&sort=updated&order=desc&per_page=30",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "qa-assessment-n8n-brief"
            }
          ]
        },
        "options": {
          "timeout": 12000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        260
      ],
      "id": "e5bae678-34fa-4e53-bde1-7b8d7fc6b9fb",
      "name": "Search GitHub repos",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first()?.json || {};\nconst fail = response.error || response.errors || response.message || null;\nif (!Array.isArray(response.items)) {\n  return [{json:{ok:false, top:null, repos:[], reason: 'GitHub search failed: ' + (typeof fail === 'string' ? fail : JSON.stringify(fail || 'invalid API shape'))}}];\n}\nconst repos = response.items\n  .filter(r => r && r.full_name && r.html_url && !r.archived)\n  .sort((a,b) => (b.stargazers_count || 0) - (a.stargazers_count || 0))\n  .slice(0,5)\n  .map(r => ({full_name:r.full_name, url:r.html_url, stars:r.stargazers_count||0, description:(r.description||'').slice(0,90), updated:r.pushed_at||''}));\nreturn [{json:{ok:repos.length>0, top:repos[0]||null, repos, reason:repos.length?'':'GitHub returned no eligible repos'}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        260
      ],
      "id": "28e6b519-9fdd-4fed-9751-d80a80d62f89",
      "name": "Keep top 5"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3f134f6f-8eb9-4bc2-8669-37182936b8c4",
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        260
      ],
      "id": "6e683521-5af3-4be3-ac10-da746796c773",
      "name": "Can enrich?"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.top.full_name + '/languages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "qa-assessment-n8n-brief"
            }
          ]
        },
        "options": {
          "timeout": 12000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "id": "7389564c-e6cf-47b6-8575-c29c1bacb4a1",
      "name": "Enrich top repo languages",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const search = $('Keep top 5').first().json;\nconst enrich = $input.first()?.json || {};\nconst fail = !search.ok;\nlet languages = [];\nif (!fail && !enrich.error && enrich && typeof enrich==='object' && !Array.isArray(enrich)) {\n  languages = Object.entries(enrich).filter(([k,v]) => typeof v==='number').sort((a,b)=>b[1]-a[1]).slice(0,3).map(([k])=>k);\n}\nconst enrichmentOK = languages.length>0;\nconst lines = fail\n ? ['Source unavailable: ' + search.reason, 'Fallback notice: check the first HTTP node and GitHub rate limit.']\n : search.repos.map((r,i) => `${i+1}. ${r.full_name} (${r.stars.toLocaleString('en-US')} stars)\\n${r.url}`);\nif (!fail) lines.push(`Top repo languages: ${enrichmentOK ? languages.join(', ') : 'unavailable (enrichment failed or empty)'}`);\nconst high = !fail && search.top.stars > 1000;\nconst heading = fail ? '⚠️ AUTOMATION API FAILURE' : (high ? '⭐ HIGH INTEREST | AUTOMATION REPOS' : '📋 AUTOMATION REPOS');\nconst message = `${heading}\\nUTC ${new Date().toISOString()}\\n\\n${lines.join('\\n\\n')}`.slice(0,1900);\nreturn [{json:{message, high, source_ok:!fail, enrichment_ok:enrichmentOK, top_stars: search.top?.stars||0, count:search.repos.length}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        260
      ],
      "id": "6783572b-bce9-4c7f-ba8e-cc7d1ae59861",
      "name": "Compose digest"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "52dce712-5006-4664-b764-fb66bf08a95a",
              "leftValue": "={{ $json.high }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
